{
  "name": "moriz-studio-redesign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint src tools/devtools tests/devtools playwright.inspector.config.ts next.config.ts postcss.config.mjs --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:inspector:unit": "node --test tests/devtools/source-loader.test.cjs",
    "test:inspector": "playwright test --config=playwright.inspector.config.ts",
    "test:inspector:production": "INSPECTOR_PRODUCTION=1 playwright test --config=playwright.inspector.config.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/matter-js": "0.20.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dom-accessibility-api": "0.7.1",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
