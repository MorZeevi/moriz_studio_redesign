      "site_name": "Fiasco",
      "asset": "home-fiasco",
      "group": "homepage",
      "title": "Fiasco",
      "context": "Selected work section",
      "observed": "Unequal image sizes form a staggered two-column composition. Names, brief explanations and discipline labels stay beside each visual.",
      "adapt": "Keep a one-sentence product explanation with every cover. Visual variety can come from image scale while the text structure stays consistent.",
      "caution": "Offsets can lengthen the section and complicate reading order. Replacing the current stacked panels is a separate design choice.",
      "local_image": "assets/projects-presentation-2026-10-11/home-fiasco.webp"
    },
    {
      "id": "48890788-7d16-4887-baaa-5b22583ef055",
