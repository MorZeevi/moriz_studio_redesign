      "site_name": "Cloudstudio",
      "asset": "home-cloudstudio",
      "group": "homepage",
      "title": "Cloudstudio",
      "context": "Selected work section",
      "observed": "A large Selected work heading precedes adjacent interface tiles with names and small metadata over the lower edge.",
      "adapt": "Use actual interface imagery so visitors can identify the kind of product before opening the project.",
      "caution": "The dark treatment obscures UI details. Keep essential names and descriptions outside busy images.",
      "local_image": "assets/projects-presentation-2026-10-11/home-cloudstudio.webp"
    },
    {
      "id": "0b70740a-eb7a-415b-b48d-09d66ce3ec38",
