      "site_name": "OFF+BRAND",
      "asset": "home-offbrand",
      "group": "homepage",
      "title": "OFF+BRAND",
      "context": "Client project cards",
      "observed": "Named cards contain a project preview and a visible action. One says View website and another says View case study.",
      "adapt": "Distinguish opening the studio's case study from visiting the client's live product. Use precise action labels.",
      "caution": "The horizontal row leaves later cards partly outside the viewport. Keep all three Moriz projects discoverable through vertical scrolling.",
      "local_image": "assets/projects-presentation-2026-10-11/home-offbrand.webp"
    },
    {
      "id": "05811dd7-a07a-41ae-9fa7-192b8eede1b1",
