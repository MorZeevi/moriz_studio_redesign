# Optional override of the owner's default WhatsApp destination.
# International digits only, without +, spaces, or punctuation.
NEXT_PUBLIC_WHATSAPP_NUMBER=972522937174

# Public project URL and publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only owner identity. Must match private.cms_admins and the Auth account.
# Admin login uses this account's Supabase Auth password (not an env password).
SUPABASE_ADMIN_EMAIL=owner@example.com
SUPABASE_ADMIN_USER_ID=your-owner-auth-uuid
# Legacy magic-link configuration helper only; not used for password login.
SUPABASE_AUTH_REDIRECT_URL=https://your-domain.example/admin/auth/callback

# Server-only Moonshot (Kimi) credentials. Never prefix with NEXT_PUBLIC_.
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
# Which AI backend the FAQ assistant uses. Only "moonshot" is supported.
AI_PROVIDER=moonshot
# Server-only Supabase secret key (Project Settings → API Keys). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# --- Moriz Diagnostic (/digital-audit). All server-only; never NEXT_PUBLIC_. ---
# Shared Supabase project, service-role access (separate from the CMS keys above).
# /digital-audit/admin has no separate secret: it uses the CMS owner login (SUPABASE_ADMIN_* above).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AI result personalization. Kill switch: only the exact string "true" enables it.
AI_PERSONALIZATION_ENABLED=false
# Optional: AI_TIMEOUT_MS (default 8000, 1000-60000), AI_MAX_TOKENS (default 400, 100-800).
# AI lead brief in the admin. Kill switch: only the exact string "true" enables it.
LEAD_BRIEF_AI_ENABLED=false
# Optional: LEAD_BRIEF_MAX_TOKENS (default 2500, 500-4000), LEAD_BRIEF_TIMEOUT_MS (default 30000, 5000-120000).
# New-lead email via Resend. Kill switch: only the exact string "true" enables it.
LEAD_NOTIFY_ENABLED=false
RESEND_API_KEY=your-resend-api-key
LEAD_NOTIFY_TO_EMAIL=inbox@example.com
LEAD_NOTIFY_FROM_EMAIL=verified-sender@example.com
# Public-site contact form. Use the Gmail App Password for morzavi1@gmail.com.
# Keep this server-only; the form sends from and to that fixed address.
CONTACT_GMAIL_APP_PASSWORD=your-16-character-google-app-password
# MOONSHOT_API_KEY / MOONSHOT_BASE_URL / MOONSHOT_MODEL / AI_PROVIDER above are shared with the diagnostic.
# Set MOONSHOT_MODEL explicitly to a model your account serves (the code default is stale).
