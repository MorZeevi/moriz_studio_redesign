# Optional. International digits only, without +, spaces, or punctuation.
# Leave empty until the owner supplies the actual WhatsApp destination.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public project URL and publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only owner identity. Must match private.is_admin() in the migration.
SUPABASE_ADMIN_EMAIL=owner@example.com
SUPABASE_ADMIN_USER_ID=your-owner-auth-uuid
# Production only: also add this exact URL to Supabase Auth's allowed redirect URLs.
SUPABASE_AUTH_REDIRECT_URL=https://your-domain.example/admin/auth/callback
